{{define "ND_TENANT_RSC"}}
resource "nd_tenant" "{{.RscName}}" {
{{- if .DependsOn}}
    depends_on = [{{.DependsOn}}]
{{- end}}
{{with .Tenant}}
    name = "{{.Name}}"
    {{- if .Description}}
    description = "{{.Description}}"
    {{- end}}
    {{- if .FabricAssociations}}
    fabric_associations = {
        {{- range $fabricName, $association := .FabricAssociations}}
        "{{$fabricName}}" = {
            {{- if $association.TenantPrefix}}
            tenant_prefix = "{{$association.TenantPrefix}}"
            {{- end}}
            {{- if $association.LocalName}}
            local_name = "{{$association.LocalName}}"
            {{- end}}
            {{- if $association.AllowedVlans}}
            allowed_vlans = [{{range $i, $v := $association.AllowedVlans}}{{if $i}}, {{end}}"{{$v}}"{{end}}]
            {{- end}}
        }
        {{- end}}
    }
    {{- end}}
{{end}}
}
{{end}}
