{{define "ND_FABRIC_ACI_RSC"}}
resource "nd_fabric_aci" "{{.RscName}}" {
{{with .FabricAci}}
    fabric_name = "{{.Spec.Aci.FabricName}}"
    hostname = "{{.Spec.Hostname}}"
    username = "{{.Spec.Credentials.Username}}"
    password = "{{.Spec.Credentials.Password}}"
    {{- if .Spec.Location.Latitude}}
    latitude = {{deref_float64 .Spec.Location.Latitude}}
    {{- end}}
    {{- if .Spec.Location.Longitude}}
    longitude = {{deref_float64 .Spec.Location.Longitude}}
    {{- end}}
    {{- if .Spec.Aci.VerifyCa}}
    verify_ca = {{deref_bool .Spec.Aci.VerifyCa}}
    {{- end}}
    {{- if .Spec.Aci.SecurityDomain}}
    security_domain = "{{.Spec.Aci.SecurityDomain}}"
    {{- end}}
    {{- if .Spec.Aci.LicenseTier}}
    license_tier = "{{.Spec.Aci.LicenseTier}}"
    {{- end}}
    {{- if .Spec.Aci.Telemetry.Network}}
    telemetry = {
        network = "{{.Spec.Aci.Telemetry.Network}}"
        {{- if .Spec.Aci.Telemetry.Epg}}
        epg = "{{.Spec.Aci.Telemetry.Epg}}"
        {{- end}}
        {{- if .Spec.Aci.Telemetry.StreamingProtocol}}
        streaming_protocol = "{{.Spec.Aci.Telemetry.StreamingProtocol}}"
        {{- end}}
    }
    {{- end}}
    {{- if .Spec.Aci.Orchestration.OrchestrationStatus}}
    orchestration_status = "{{.Spec.Aci.Orchestration.OrchestrationStatus}}"
    {{- end}}
{{end}}
}
{{end}}

{{define "ND_FABRIC_ACI_DS"}}
{{with .FabricAciDataSource}}
data "nd_fabric_aci" "{{.RscName}}" {
    fabric_name = "{{.FabricName}}"
    {{if .DependsOn}}
    depends_on = [{{.DependsOn}}]
    {{end}}
}
{{end}}
{{end}}
